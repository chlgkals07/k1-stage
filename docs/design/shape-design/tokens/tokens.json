{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "SHAPE 디자인 토큰. 이 파일이 유일한 원천이고 tokens/tokens.css 는 scripts/build-tokens.mjs 가 여기서 만들어 냅니다. 값은 www.snu-shape.com 의 실제 CSS 에서 뽑아 쓰임대로 묶은 것이라, 새로 지어낸 색이 없습니다.",

  "color": {
    "$type": "color",
    "brand": {
      "$description": "SHAPE 의 파랑. 링크·기본 버튼·강조 숫자에 씁니다.",
      "blue":        { "$value": "#2855f3", "$description": "기본 브랜드색. 버튼 배경, 링크, eyebrow 라벨" },
      "blue-press":  { "$value": "#1d4eb5", "$description": "밝은 바탕 위 강한 파랑 글자, 눌린 상태" },
      "blue-label":  { "$value": "#1b4bc4", "$description": "파란 배지의 글자색" },
      "navy":        { "$value": "#0c245e", "$description": "가장 어두운 남색. 푸터, 큰 면" },
      "navy-deep":   { "$value": "#142354", "$description": "활성 내비 글자" },
      "navy-mid":    { "$value": "#163c91", "$description": "짙은 카드 배경" },
      "navy-solid":  { "$value": "#243e78", "$description": "선택된 토글 배경" },
      "sky":         { "$value": "#90afff", "$description": "어두운 바탕 위 보조 글자" }
    },
    "ink": {
      "$description": "글자색 사다리. 위로 갈수록 진합니다. 본문은 500, 제목은 900.",
      "900": { "$value": "#111111" },
      "800": { "$value": "#20242b" },
      "700": { "$value": "#39404d" },
      "600": { "$value": "#4c5360" },
      "500": { "$value": "#69717f" },
      "400": { "$value": "#8a9099" },
      "300": { "$value": "#9aa4b6" }
    },
    "line": {
      "$description": "테두리. 카드는 soft, 입력칸은 base, 눌리는 것은 strong.",
      "strong": { "$value": "#cbd3e2" },
      "base":   { "$value": "#d6dce6" },
      "soft":   { "$value": "#e2e6ee" },
      "faint":  { "$value": "#eef0f4" }
    },
    "surface": {
      "$description": "면. 흰 종이 위에 아주 옅은 회색·파랑을 얹는 방식입니다.",
      "page":        { "$value": "#ffffff" },
      "subtle":      { "$value": "#f7f8fb", "$description": "댓글, 안내 상자" },
      "sunken":      { "$value": "#f4f6fa", "$description": "접히는 영역, 요약 줄" },
      "blue":        { "$value": "#f4f7ff", "$description": "파란 기 도는 옅은 면, hover" },
      "blue-strong": { "$value": "#e8efff", "$description": "선택·승인 상태 면" },
      "blue-page":   { "$value": "#f0f5ff", "$description": "홈의 큰 파란 구획" }
    },
    "status": {
      "$description": "상태 색은 언제나 글자색과 배경색이 짝입니다. 한쪽만 쓰지 마세요.",
      "info":    { "fg": { "$value": "#1b4bc4" }, "bg": { "$value": "#e7edff" } },
      "success": { "fg": { "$value": "#1d6b40" }, "bg": { "$value": "#e7f6ed" } },
      "warn":    { "fg": { "$value": "#7a5405" }, "bg": { "$value": "#fdf1d8" } },
      "danger":  { "fg": { "$value": "#b62446" }, "bg": { "$value": "#fdf3f5" }, "border": { "$value": "#f0d2d9" }, "quiet": { "$value": "#8a3a4e" } },
      "staff":   { "fg": { "$value": "#93341f" }, "bg": { "$value": "#ffe9df" } }
    },
    "overlay": {
      "backdrop": { "$value": "rgba(10,19,39,.5)", "$description": "대화상자 뒤 어둡게" },
      "grid":     { "$value": "rgba(43,70,110,.045)", "$description": "히어로의 모눈 배경선" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["pretendard", "Pretendard Variable", "Pretendard", "Apple SD Gothic Neo", "Noto Sans KR", "Arial", "sans-serif"],
                "$description": "Pretendard Variable 한 벌만 씁니다. 세리프·모노를 새로 들이지 마세요." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400, "$description": "본문 중 긴 글에만" },
      "bold":    { "$value": 700 },
      "heavy":   { "$value": 800, "$description": "UI 기본. 버튼·라벨·표 머리" },
      "black":   { "$value": 900, "$description": "제목과 숫자" }
    },
    "size": {
      "$type": "dimension",
      "micro":    { "$value": "10px", "$description": "배지, 최소 라벨" },
      "caption":  { "$value": "11px" },
      "small":    { "$value": "12px", "$description": "메타 정보, 시각" },
      "body-sm":  { "$value": "13px", "$description": "화면에서 가장 많이 쓰는 크기" },
      "body":     { "$value": "14px" },
      "body-lg":  { "$value": "15px" },
      "lead":     { "$value": "17px", "$description": "소개 문단" },
      "title-sm": { "$value": "19px" },
      "title":    { "$value": "22px" },
      "title-lg": { "$value": "24px" },
      "heading":  { "$value": "32px" },
      "display":  { "$value": "clamp(44px, 4.5vw, 74px)", "$description": "구획 제목" },
      "hero":     { "$value": "clamp(58px, 7vw, 108px)", "$description": "첫 화면 큰 글자" }
    },
    "leading": {
      "tight":  { "$value": "1.12", "$description": "display 이상" },
      "snug":   { "$value": "1.25", "$description": "제목" },
      "normal": { "$value": "1.6", "$description": "본문 기본" },
      "loose":  { "$value": "1.75", "$description": "긴 소개 문단" }
    },
    "tracking": {
      "$description": "한글 큰 제목은 음수로 좁혀야 SHAPE 느낌이 납니다. 대문자 라벨만 양수.",
      "hero":    { "$value": "-.08em" },
      "display": { "$value": "-.07em" },
      "title":   { "$value": "-.05em" },
      "card":    { "$value": "-.04em" },
      "body":    { "$value": "0" },
      "eyebrow": { "$value": ".14em", "$description": "구획 위 작은 영문 라벨. 900 굵기 13px 와 함께" }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "2·4 배수 위주. 좁은 UI 는 6~14, 카드 안은 18~30, 구획 사이는 56~120.",
    "1":  { "$value": "2px" },  "2":  { "$value": "4px" },  "3":  { "$value": "6px" },
    "4":  { "$value": "8px" },  "5":  { "$value": "10px" }, "6":  { "$value": "12px" },
    "7":  { "$value": "14px" }, "8":  { "$value": "16px" }, "9":  { "$value": "18px" },
    "10": { "$value": "20px" }, "11": { "$value": "24px" }, "12": { "$value": "26px" },
    "13": { "$value": "30px" }, "14": { "$value": "34px" }, "15": { "$value": "40px" },
    "16": { "$value": "56px" }, "17": { "$value": "80px" }, "18": { "$value": "120px" }
  },

  "radius": {
    "$type": "dimension",
    "xs":     { "$value": "8px",   "$description": "배지, 작은 칩" },
    "sm":     { "$value": "10px",  "$description": "입력칸, 드롭다운 항목" },
    "md":     { "$value": "12px",  "$description": "기본. 상자 대부분" },
    "lg":     { "$value": "14px" },
    "xl":     { "$value": "18px",  "$description": "카드" },
    "2xl":    { "$value": "22px",  "$description": "대화상자, 메뉴" },
    "3xl":    { "$value": "30px",  "$description": "히어로, 큰 구획" },
    "media":  { "$value": "16px",  "$description": "사진" },
    "media-inline": { "$value": "12px" },
    "pill":   { "$value": "999px", "$description": "버튼·내비·태그는 전부 알약" },
    "circle": { "$value": "50%" }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "그림자는 언제나 파란 기가 도는 남색 계열입니다. 검정 그림자를 쓰지 마세요.",
    "raise":  { "$value": "0 3px 12px rgba(23,45,88,.07)",   "$description": "살짝 뜬 것" },
    "card":   { "$value": "0 16px 35px rgba(30,60,120,.08)", "$description": "카드 hover" },
    "float":  { "$value": "0 12px 38px rgba(18,40,80,.12)",  "$description": "떠 있는 막대·레일" },
    "pop":    { "$value": "0 18px 44px rgba(22,37,75,.13)",  "$description": "드롭다운, 메뉴" },
    "header": { "$value": "0 10px 35px rgba(14,28,56,.08)",  "$description": "스크롤된 머리글" },
    "dialog": { "$value": "0 35px 100px rgba(12,24,52,.3)",  "$description": "대화상자" },
    "brand":  { "$value": "0 5px 12px rgba(40,85,243,.3)",   "$description": "파란 버튼이 눌릴 때" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "140ms", "$description": "포인터를 따라가는 3D 기울기" },
      "fast":    { "$value": "200ms", "$description": "hover, 색 바뀜" },
      "base":    { "$value": "250ms", "$description": "펼침, 머리글 축소" },
      "slow":    { "$value": "350ms" },
      "reveal":  { "$value": "550ms", "$description": "화면에 들어오며 나타나기" },
      "long":    { "$value": "850ms", "$description": "내비 라벨 X축 회전" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.8, 0.2, 1],   "$description": "기본. 들어오는 모든 것" },
      "soft":     { "$value": [0.2, 0.75, 0.2, 1],  "$description": "긴 회전·미끄러짐" },
      "out":      { "$value": [0, 0, 0.2, 1] },
      "inout":    { "$value": [0.4, 0, 0.2, 1],     "$description": "무한 반복(떠다니기, 물결)" }
    },
    "perspective": {
      "$type": "dimension",
      "$description": "3D 는 세 자리에서만 씁니다. 값이 작을수록 왜곡이 큽니다.",
      "label": { "$value": "520px", "$description": "내비 라벨 뒤집기" },
      "card":  { "$value": "900px", "$description": "손에 든 카드 기울이기" },
      "stage": { "$value": "1000px", "$description": "로봇 무대 시차" }
    },
    "tilt": {
      "$description": "포인터 추적 기울기의 최대 각. 이보다 크면 멀미가 납니다.",
      "card-x":  { "$value": "9deg" },
      "card-y":  { "$value": "11deg" },
      "stage-x": { "$value": "3deg" },
      "stage-y": { "$value": "5deg" }
    },
    "stagger": { "$value": "45ms", "$description": "목록이 하나씩 나타날 때 항목 사이 간격. 4개마다 되감습니다." }
  },

  "layout": {
    "$type": "dimension",
    "content-max":  { "$value": "1680px" },
    "reading-max":  { "$value": "760px", "$description": "긴 글의 최대 폭" },
    "header":       { "$value": "102px" },
    "header-small": { "$value": "80px", "$description": "스크롤된 뒤" },
    "gutter":       { "$value": "max(7vw, calc((100vw - 1680px) / 2))" },
    "gutter-mobile":{ "$value": "20px" }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "전부 max-width 기준입니다. 데스크톱 규칙을 먼저 쓰고 좁은 쪽에서 덮습니다.",
    "narrow":  { "$value": "430px", "$description": "작은 휴대전화" },
    "phone":   { "$value": "620px" },
    "mobile":  { "$value": "680px", "$description": "가장 중요한 분기. 여기서 데스크톱 레이아웃을 접습니다" },
    "tablet":  { "$value": "900px" },
    "laptop":  { "$value": "1100px" },
    "wide":    { "$value": "1400px" }
  }
}
