+TEST(ModeController, ApiTeleopPassthroughPreservesLocomotionAcrossAuthorityChange)
+{
+  ModeControllerFixture fixture(true, true);
+  fixture.release_startup_gate();
+  fixture.shared_data_.teleop.input_code = kVelocityInputCode;
+  fixture.shared_data_.teleop.velocity_commands.x() = 0.25F;
+  fixture.update_controller();
+  ASSERT_EQ(fixture.controller_->status_snapshot().active_state, "Velocity");
+  EXPECT_FLOAT_EQ(fixture.shared_data_.mode.velocity_commands.x(), 0.25F);
+
+  fixture.set_api_heartbeat_valid(true);
+  fixture.shared_data_.teleop.api_mode_requested = true;
+  fixture.update_controller();
+  EXPECT_STREQ(fixture.controller_->status_snapshot().authority, "API_WARMUP");
+  EXPECT_EQ(fixture.controller_->status_snapshot().active_state, "Velocity");
+  EXPECT_FLOAT_EQ(fixture.shared_data_.mode.velocity_commands.x(), 0.25F);
+
+  fixture.shared_data_.teleop.velocity_commands.x() = 0.15F;
+  fixture.shared_data_.api.velocity_commands.x() = 0.9F;
+  fixture.update_controller();
+  EXPECT_STREQ(fixture.controller_->status_snapshot().authority, "API");
+  EXPECT_EQ(fixture.controller_->status_snapshot().active_state, "Velocity");
+  EXPECT_FLOAT_EQ(fixture.shared_data_.mode.velocity_commands.x(), 0.15F);
+}
+
+TEST(ModeController, ApiTeleopPassthroughKeepsReadyPoseAcrossAuthorityChange)
+{
+  ModeControllerFixture fixture(true, true);
+  fixture.release_startup_gate();
+  fixture.set_api_heartbeat_valid(true);
+  fixture.shared_data_.teleop.api_mode_requested = true;
+
+  fixture.update_controller();
+  EXPECT_STREQ(fixture.controller_->status_snapshot().authority, "API_WARMUP");
+  EXPECT_EQ(fixture.controller_->status_snapshot().active_state, "ReadyPose");
+
+  fixture.update_controller();
+  EXPECT_STREQ(fixture.controller_->status_snapshot().authority, "API");
+  EXPECT_EQ(fixture.controller_->status_snapshot().active_state, "ReadyPose");
+}
+
+TEST(ModeController, ApiMimicCompletionReturnsToCurrentTeleopVelocity)
+{
+  ModeControllerFixture fixture(true, true);
+  fixture.release_startup_gate();
+  fixture.shared_data_.teleop.input_code = kVelocityInputCode;
+  fixture.shared_data_.teleop.velocity_commands.x() = 0.2F;
+  fixture.update_controller();
+
+  fixture.set_api_heartbeat_valid(true);
+  fixture.shared_data_.teleop.api_mode_requested = true;
+  fixture.update_controller();
+  fixture.update_controller();
+  ASSERT_STREQ(fixture.controller_->status_snapshot().authority, "API");
+
+  const auto request_result = fixture.controller_->request_mode_by_name("MimicRun");
+  ASSERT_TRUE(request_result.success);
+  fixture.update_controller();
+  ASSERT_EQ(fixture.controller_->status_snapshot().active_state, "MimicRun");
+
+  fixture.shared_data_.teleop.velocity_commands.x() = 0.1F;
+  fixture.shared_data_.requests.state_name = "Velocity";
+  fixture.update_controller();
+  EXPECT_EQ(fixture.controller_->status_snapshot().active_state, "Velocity");
+  EXPECT_FLOAT_EQ(fixture.shared_data_.mode.velocity_commands.x(), 0.1F);
+}
+
+TEST(ModeController, ApiHeartbeatLossStillZerosPassthroughVelocityBeforeManualHandoff)
