local selected = 1
local cursor = 1
local fieldIds = {}
local gvValue = nil
local ch11Pct = nil
local ch12Value = nil
local gvWrite = "INIT"
local ch12Write = "INIT"
local edit = false
local lastRunTime = nil
local exitResetDone = true
local RESET_DELAY = 50
local trimSwitchIds = nil
local trimSwitchLastScan = nil
local trimComboStart = nil
local trimComboConsumed = false
local trimPressedCount = 0
local trimFoundCount = 0
local trimKeyCount = 0
local trimStatus = "T?/0K0"
local hatKeyDown = {}
local rotaryUntil = 0

local hatTrimKeyCodes = {
  [4] = true,  -- PAGEUP: right hat left
  [5] = true,  -- PAGEDN: right hat right
  [12] = true, -- MODEL: left hat right
  [13] = true, -- TELE: left hat down
  [14] = true, -- SYS: left hat up
}

local function clamp(v, minv, maxv)
  if v < minv then return minv end
  if v > maxv then return maxv end
  return v
end

local function findFieldId(names)
  for i = 1, #names do
    local ok, field = pcall(getFieldInfo, names[i])
    if ok and field ~= nil and field.id ~= nil then
      return field.id
    end
  end
  return nil
end

local function readSource(key, names)
  local id = fieldIds[key]

  if id == nil then
    id = findFieldId(names)
    fieldIds[key] = id or false
  elseif id == false then
    id = nil
  end

  if id ~= nil then
    local ok, value = pcall(getValue, id)
    if ok then
      return value
    end
  end

  for i = 1, #names do
    local ok, value = pcall(getValue, names[i])
    if ok and value ~= nil then
      return value
    end
  end

  return nil
end

local function readValue(name)
  return readSource(name, { name, string.lower(name) })
end

local function asNumber(value)
  if type(value) == "number" then
    return value
  elseif type(value) == "table" then
    return value.value or value.val or nil
  end
  return nil
end

local function sourceToPct(value)
  value = asNumber(value)
  if value == nil then
    return nil
  end

  if value < -100 or value > 100 then
    value = value * 100 / 1024
  end

  if value >= 0 then
    value = math.floor(value + 0.5)
  else
    value = math.ceil(value - 0.5)
  end

  return clamp(value, -100, 100)
end

local function text(value, empty)
  if value == nil then
    return empty or "--"
  end
  return tostring(value)
end

local function shortText(value, maxLen)
  value = tostring(value)
  if #value <= maxLen then
    return value
  end
  return string.sub(value, 1, maxLen - 2) .. ".."
end

local function nearestMode(value)
  local best = 1
  local bestDiff = math.abs(value - modes[1].pct)

  for i = 2, #modes do
    local diff = math.abs(value - modes[i].pct)
    if diff < bestDiff then
      best = i
      bestDiff = diff
    end
  end

  return best
end

local function switchPos(name)
  local pct = sourceToPct(readValue(name))
  if pct == nil then
    return 0, nil, nil
  elseif pct < -33 then
    return 0, pct, 1000
  elseif pct > 33 then
    return 2, pct, 2000
  end
  return 1, pct, 1500
end

local function scModeName(pos)
  if pos == 0 then
    return "Passive"
  elseif pos == 1 then
    return "Fixstand"
  end
  return "Demo_Mode"
end

local function maxValue(a, b)
  if a == nil then return b end
  if b == nil then return a end
  if a > b then return a end
  return b
end

local function linkStatus()
  local rqly = asNumber(readValue("RQly"))
  local rssi1 = asNumber(readValue("1RSS"))
  local rssi2 = asNumber(readValue("2RSS"))
  local rxbt = asNumber(readValue("RxBt"))
  local rssi = maxValue(rssi1, rssi2)

  if rqly ~= nil then
    if rqly <= 0 then
      return "FS?", rqly, rssi, rxbt
    elseif rqly < 70 then
      return "WARN", rqly, rssi, rxbt
    end
    return "OK", rqly, rssi, rxbt
  end

  if rxbt ~= nil or rssi ~= nil then
    return "TEL", rqly, rssi, rxbt
  end

  return "FS?", rqly, rssi, rxbt
end

local function shortLink(link)
  if link == "WARN" then
    return "WRN"
  end
  return link
end

local function nowTicks()
  if getTime ~= nil then
    local ok, value = pcall(getTime)
    if ok and type(value) == "number" then
      return value
    end
  end
  return 0
end

local function batteryStatus()
  local pct = asNumber(readValue("Bat%"))
  local volts = asNumber(readValue("RxBt"))

  if pct ~= nil then
    pct = clamp(math.floor(pct + 0.5), 0, 100)
  end

  return pct, volts
end

local function fillRect(x, y, w, h)
  if w <= 0 or h <= 0 then
    return
  end

  if lcd.drawFilledRectangle ~= nil then
    lcd.drawFilledRectangle(x, y, w, h)
  elseif lcd.drawLine ~= nil then
    for i = 0, w - 1 do
      lcd.drawLine(x + i, y, x + i, y + h - 1, SOLID, 0)
    end
  else
    for i = 0, h - 1 do
      lcd.drawRectangle(x, y + i, w, 1)
    end
  end
end

local function drawBatteryIcon(x, y, w, h, pct)
  lcd.drawRectangle(x, y, w, h)
  lcd.drawRectangle(x + w, y + math.floor(h / 3), 2, math.floor(h / 3) + 1)

  if pct == nil then
    lcd.drawText(x + 5, y + 1, "?", SMLSIZE)
    return
  end

  local fill = math.floor((w - 4) * pct / 100)
  if fill > 0 then
    fillRect(x + 2, y + 2, fill, h - 4)
  end
end

local function syncFromGv(updateSelection)
  if model ~= nil and model.getGlobalVariable ~= nil then
    gvValue = model.getGlobalVariable(GV_INDEX, FM_INDEX)
    if gvValue ~= nil and updateSelection ~= false then
      selected = nearestMode(gvValue)
      cursor = selected
    end
  end

  if model ~= nil and model.getGlobalVariable ~= nil then
    ch12Value = model.getGlobalVariable(CH12_GV_INDEX, FM_INDEX)
  end

  ch11Pct = sourceToPct(readSource("CH11", { "ch11", "CH11", "Ch11", "chan11", "Chan11" }))
end

local function setMode(index, label)
  if model ~= nil and model.setGlobalVariable ~= nil then
    local ok = pcall(model.setGlobalVariable, GV_INDEX, FM_INDEX, modes[index].pct)
    gvWrite = ok and label or "ERR"
  else
    gvWrite = "NOAPI"
  end

  syncFromGv()
end

local function applyMode()
  setMode(selected, "OK")
end

local function isTrimSwitchName(name)
  return type(name) == "string"
    and (trimSwitchNameSet[name]
      or string.match(name, "^T%d+[+-]$") ~= nil
      or string.match(name, "^TR%d+[+-]$") ~= nil
      or string.match(name, "^Trim") ~= nil)
end

local function addTrimSwitchId(ids, id)
  if type(id) ~= "number" then
    return
  end

  for i = 1, #ids do
    if ids[i] == id then
      return
    end
  end

  ids[#ids + 1] = id
end

local function initTrimSwitchIds()
  local now = nowTicks()
  if trimSwitchIds ~= nil and (#trimSwitchIds > 0
      or (trimSwitchLastScan ~= nil and now - trimSwitchLastScan < TRIM_RESCAN_DELAY)) then
    return
  end

  trimSwitchIds = {}
  trimSwitchLastScan = now

  if switches ~= nil then
    pcall(function()
      for id, name in switches() do
        if isTrimSwitchName(name) then
          addTrimSwitchId(trimSwitchIds, id)
        end
      end
    end)
  end

  if getSwitchIndex ~= nil then
    for i = 1, #trimSwitchNames do
      local ok, id = pcall(getSwitchIndex, trimSwitchNames[i])
      if ok then
        addTrimSwitchId(trimSwitchIds, id)
      end
    end
  end
end

local function isRotaryTrimEvent(event)
  return (EVT_ROT_LEFT ~= nil and event == EVT_ROT_LEFT)
    or (EVT_ROT_RIGHT ~= nil and event == EVT_ROT_RIGHT)
    or (EVT_ROTARY_LEFT ~= nil and event == EVT_ROTARY_LEFT)
    or (EVT_ROTARY_RIGHT ~= nil and event == EVT_ROTARY_RIGHT)
end

local function handleHatKeyEvent(event)
  if type(event) ~= "number" or event == 0 then
    return
  end

  local now = nowTicks()
  if isRotaryTrimEvent(event) then
    rotaryUntil = now + HAT_KEY_LATCH
    return
  end

  local key = event % KEY_CODE_MOD
  local flag = event - key
  if not hatTrimKeyCodes[key] then
    return
  end

  if flag == KEY_FLAG_FIRST or flag == KEY_FLAG_LONG or flag == KEY_FLAG_REPT then
    hatKeyDown[key] = now + HAT_KEY_LATCH
  elseif flag == KEY_FLAG_BREAK then
    hatKeyDown[key] = nil
  end
end

local function pressedHatKeyCount()
  local now = nowTicks()
  local count = 0

  for key, expires in pairs(hatKeyDown) do
    if expires >= now then
      count = count + 1
    else
      hatKeyDown[key] = nil
    end
  end

  if rotaryUntil >= now then
    count = count + 1
  end

  trimKeyCount = count
  return count
end

local function pressedTrimCount()
  local keyCount = pressedHatKeyCount()

  if getSwitchValue == nil then
    trimPressedCount = 0
    trimFoundCount = 0
    trimStatus = string.format("NOAPIK%d", keyCount)
    return keyCount
  end

  initTrimSwitchIds()
  trimFoundCount = #trimSwitchIds

  local count = 0
  for i = 1, #trimSwitchIds do
    local ok, pressed = pcall(getSwitchValue, trimSwitchIds[i])
    if ok and pressed then
      count = count + 1
    end
  end
  trimPressedCount = count
  trimStatus = string.format("T%d/%dK%d", trimPressedCount, trimFoundCount, keyCount)
  if keyCount > count then
    return keyCount
  end
  return count
end

local function setCh12(value, label)
  ch12Value = value

  if model ~= nil and model.setGlobalVariable ~= nil then
    local ok = pcall(model.setGlobalVariable, CH12_GV_INDEX, FM_INDEX, value)
    ch12Write = ok and label or "ERR"
  else
    ch12Write = "NOAPI"
  end

  syncFromGv(false)
end

local function handleTrimCombo()
  local pressed = pressedTrimCount() >= 2
  local now = nowTicks()

  if pressed then
    if trimComboStart == nil then
      trimComboStart = now
      trimComboConsumed = false
    elseif not trimComboConsumed
        and now - trimComboStart >= TRIM_HOLD_DELAY then
      setCh12(CH12_DEFAULT, "RST")
      trimComboConsumed = true
    end
  elseif trimComboStart ~= nil then
    if not trimComboConsumed then
      setCh12(CH12_ACTIVE, "SET")
    end
    trimComboStart = nil
    trimComboConsumed = false
  end
end

local function changeCursor(delta)
  cursor = clamp(cursor + delta, 1, #modes)
end

local function commitCursor()
  selected = cursor
  applyMode()
end

local function resetMode()
  selected = 1
  cursor = 1
  edit = false
  setMode(selected, "RST")
  exitResetDone = true
end

local function isEvent(event, value)
  return value ~= nil and event == value
end

local function isIncEvent(event)
  return isEvent(event, EVT_ROT_RIGHT)
end

local function isDecEvent(event)
  return isEvent(event, EVT_ROT_LEFT)
end

local function isEnterEvent(event)
  return isEvent(event, EVT_VIRTUAL_ENTER)
end

local function isExitEvent(event)
  return isEvent(event, EVT_VIRTUAL_EXIT)
    or isEvent(event, EVT_EXIT_BREAK)
    or isEvent(event, EVT_EXIT_LONG)
end

local function drawSmall()
  local display = edit and cursor or selected
  local mode = modes[display]
  local maxMode = #modes - 1
  local sbPos = switchPos("SB")
  local scPos = switchPos("SC")
  local link = linkStatus()
  local batPct, batVolts = batteryStatus()

  lcd.clear()
  lcd.drawText(0, 0, "Robot", SMLSIZE)
  lcd.drawText(36, 0, string.format("Link:%s", shortLink(link)), SMLSIZE)
  lcd.drawText(LCD_W - 1, 0, edit and "EDIT" or "VIEW", SMLSIZE + RIGHT + (edit and BLINK or 0))

  lcd.drawText(0, 12, string.format("M:%02d/%02d  PWM:%d us",
    display - 1,
    maxMode,
    mode.pwm), SMLSIZE)

  lcd.drawText(0, 24, mode.name, SMLSIZE)
  lcd.drawText(0, 36, scModeName(scPos), SMLSIZE)

  lcd.drawText(0, 48, "Bat", SMLSIZE)
  drawBatteryIcon(24, 48, 26, 7, batPct)
  lcd.drawText(56, 48, batPct and string.format("%d%%", batPct) or "--%", SMLSIZE)
  lcd.drawText(LCD_W - 1, 48,
    batVolts and string.format("%.1fV", batVolts) or "--.-V",
    SMLSIZE + RIGHT)

  lcd.drawText(0, 56, string.format("SB:%d %s", sbPos, trimStatus), SMLSIZE)
  lcd.drawText(LCD_W - 1, 56,
    string.format("C12:%+d", ch12Value or CH12_DEFAULT),
    SMLSIZE + RIGHT)
end

local function drawLarge()
  local display = edit and cursor or selected
  local mode = modes[display]
  local maxMode = #modes - 1
  local sbPos = switchPos("SB")
  local scPos = switchPos("SC")
  local link, rqly, rssi, rxbt = linkStatus()
  local batPct, batVolts = batteryStatus()

  lcd.clear()
  lcd.drawText(4, 4, "Robot Telemetry", MIDSIZE)
  lcd.drawText(LCD_W - 4, 4, edit and "EDIT" or "VIEW", RIGHT + (edit and BLINK or 0))
  lcd.drawText(4, 22, string.format("Link %s  RQly %s%%  RSSI %s",
    link,
    text(rqly),
    text(rssi)), SMLSIZE)

  lcd.drawText(4, 30, "Mode", 0)
  lcd.drawText(80, 26, string.format("%02d / %02d", display - 1, maxMode), DBLSIZE)

  lcd.drawText(4, 64, "PWM", 0)
  lcd.drawText(80, 60, string.format("%d us", mode.pwm), MIDSIZE)

  lcd.drawText(4, 92, "Name", 0)
  lcd.drawText(80, 88, mode.name, MIDSIZE)

  lcd.drawText(4, 124, "State", 0)
  lcd.drawText(80, 120, scModeName(scPos), MIDSIZE)

  lcd.drawText(4, 148, string.format("SB: %d", sbPos), 0)
  lcd.drawText(LCD_W - 4, 148, string.format("SC: %d  %s", scPos, trimStatus), RIGHT)

  lcd.drawText(4, 170, "CH12", 0)
  lcd.drawText(80, 166,
    string.format("%+d%% %s", ch12Value or CH12_DEFAULT, ch12Write),
    MIDSIZE)

  lcd.drawText(4, 198, "Battery", 0)
  drawBatteryIcon(80, 196, 42, 14, batPct)
  lcd.drawText(130, 198, string.format("%s%%  %sV",
    batPct and string.format("%d", batPct) or "--",
    batVolts and string.format("%.1f", batVolts) or (rxbt and string.format("%.1f", rxbt) or "--")), 0)
end

local function background()
  handleTrimCombo()

  if exitResetDone or lastRunTime == nil then
    return
  end

  if nowTicks() - lastRunTime > RESET_DELAY then
    resetMode()
  end
end

local function run(event)
  lastRunTime = nowTicks()
  exitResetDone = false
  handleHatKeyEvent(event)
  handleTrimCombo()

  if isExitEvent(event) then
    resetMode()
  elseif isEnterEvent(event) then
    if edit then
      commitCursor()
      edit = false
    else
      syncFromGv(true)
      cursor = selected
      edit = true
    end
  elseif edit and isIncEvent(event) then
    changeCursor(1)
    syncFromGv(false)
  elseif edit and isDecEvent(event) then
    changeCursor(-1)
    syncFromGv(false)
  else
    syncFromGv(not edit)
  end

  if LCD_H <= 64 then
    drawSmall()
  else
    drawLarge()
  end

  return 0
end

return {
  background = background,
  run = run
}
